@model IEnumerable<Category>
@{
    ViewData["Title"] = "التصنيفات";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3">قائمة التصنيفات</h1>
    <a asp-action="Create" class="btn btn-primary">+ تصنيف جديد</a>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">لا توجد تصنيفات بعد.</div>
}
else
{
    <table class="table table-striped table-hover align-middle">
        <thead class="table-dark">
            <tr>
                <th>الاسم</th>
                <th>الوصف</th>
                <th>عدد المنتجات</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Name</td>
                    <td>@item.Description</td>
                    <td><span class="badge bg-info text-dark">@item.Products.Count</span></td>
                    <td class="text-end">
                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info">تفاصيل</a>
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning">تعديل</a>
                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">حذف</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
