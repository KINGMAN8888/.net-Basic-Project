@model IEnumerable<Product>
@{
    ViewData["Title"] = "المنتجات";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3">قائمة المنتجات</h1>
    <a asp-action="Create" class="btn btn-primary">+ منتج جديد</a>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">لا توجد منتجات بعد.</div>
}
else
{
    <table class="table table-striped table-hover align-middle">
        <thead class="table-dark">
            <tr>
                <th>الاسم</th>
                <th>التصنيف</th>
                <th>السعر</th>
                <th>المخزن</th>
                <th>الحالة</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Name</td>
                    <td><span class="badge bg-secondary">@item.Category?.Name</span></td>
                    <td>@item.Price.ToString("N2")</td>
                    <td>@item.Stock</td>
                    <td>
                        @if (item.IsAvailable)
                        {
                            <span class="badge bg-success">متاح</span>
                        }
                        else
                        {
                            <span class="badge bg-danger">غير متاح</span>
                        }
                    </td>
                    <td class="text-end">
                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info">تفاصيل</a>
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning">تعديل</a>
                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">حذف</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
